# Copy to .env.local and fill in — see README "GitHub OAuth setup" for
# exactly how to get these values. Nothing here is required to run the app;
# without them, sign-in and private-repo sync are unavailable but everything
# else (wall, submit, portfolio pages, public GitHub sync by username,
# collections, command palette) works fine.

GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional — raises the *unauthenticated* GitHub sync rate limit from
# 60/hr to 5,000/hr. Unrelated to the OAuth vars above; a personal access
# token with no special scopes is enough.
GITHUB_TOKEN=
